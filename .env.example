# Supabase configuration for local development.
# Copy this file to `.env` in the PROJECT ROOT (the folder containing vite.config.ts)
# and fill in the real values.
#
#   copy .env.example .env        # Windows PowerShell / CMD
#   cp .env.example .env          # macOS / Linux
#
# Both values come from the Supabase dashboard:
#   Project Settings -> API
#
# Vite only reads .env from the project root. A .env placed in a PARENT directory
# is silently ignored and the app will fail to start.

# Your project URL. Must be https:// and end in .supabase.co
#
#   CORRECT:   https://abcdefghijklmnop.supabase.co
#   WRONG:     https://abcdefghijklmnop.supabase.co/rest/v1/   <-- do not do this
#   WRONG:     .../rest/v1/auth/v1/                            <-- do not do this
#
# Copy the Project URL straight from Project Settings -> API -> Data API.
# Do NOT append any API path. The client appends /auth/v1 and /rest/v1 itself,
# and a path here produces a confusing gateway error:
#   {"message":"No API key found in request"}
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your anon key (legacy `eyJ...` JWT) or publishable key (`sb_publishable_...`).
#
# This value is deliberately NOT secret — it ships in the browser bundle by design.
# Your data is protected by Row Level Security policies in schema.sql, not by
# hiding this key. Never put the `service_role` key (or any `sb_secret_` key) here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key